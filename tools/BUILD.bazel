load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@rules_python//python:py_binary.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

# Format every Starlark / BUILD file in the workspace. Run with
# `bazel run //tools:buildifier`.
buildifier(
    name = "buildifier",
)

# Writes registry/ from overlay/, tests/ and upstream.json:
# `bazel run //tools:make_entry`. With `-- --check` it only reports whether
# registry/ is current, which is what CI runs.
py_binary(
    name = "make_entry",
    srcs = ["make_entry.py"],
    data = ["presubmit.yml"],
)

exports_files(["presubmit.yml"])
