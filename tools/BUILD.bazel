load("@buildifier_prebuilt//:rules.bzl", "buildifier")

package(default_visibility = ["//visibility:public"])

# Format every Starlark / BUILD file in the workspace. Run with
# `bazel run //tools:buildifier`. Kept in a separate package so that
# `buildifier_prebuilt` (a dev-only dependency) is not pulled into
# downstream consumers of `@graphviz`.
buildifier(
    name = "buildifier",
)
