# The module this repository publishes is not this file: it is overlay/, laid
# over the upstream graphviz source archive by a Bazel registry. See
# upstream.json and tools/make_entry.py.
#
# This is the development module. It consumes @graphviz from the registry
# entry in registry/, through --registry=file://... in .bazelrc, so what is
# built and tested here is exactly what a registry user gets.
module(
    name = "graphviz_dev",
    version = "0.0.0",
)

bazel_dep(name = "graphviz", version = "14.0.0.bcr.1")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_python", version = "2.3.3")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4", dev_dependency = True)

# The C++ toolchain graphviz is built with here. A consumer registers its own;
# the overlay's MODULE.bazel registers none, since register_toolchains is the
# root module's decision.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", dev_dependency = True)

toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
    dev_dependency = True,
)
